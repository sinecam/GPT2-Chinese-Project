{"id":"identity_01","category":"identity","prompt":"请用一句话说明你是谁。不要编造姓名、职业或真实人物身份。","reference":"我是一个中文AI助手，可以根据你的问题提供文本帮助。","max_new_tokens":60,"checks":[{"type":"contains_any","values":["中文AI助手","中文 AI 助手","人工智能助手"],"weight":2},{"type":"not_contains_any","values":["约翰","史密斯","律师","医生","教授","我叫","我叫"],"weight":2,"gate":true},{"type":"sentence_count","min":1,"max":2}]}
